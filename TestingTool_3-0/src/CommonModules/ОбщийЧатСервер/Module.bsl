Функция ЗайтиВИгровуюКомнату(Знач ИдентификаторУчастника,Знач ИгроваяКомната) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.СоставКомнатыДляЧата.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторКомнаты = ИгроваяКомната;
	МенеджерЗаписи.ИдентификаторУчастника = ИдентификаторУчастника;
	МенеджерЗаписи.Записать(Истина);
	
	Возврат Истина;
	
КонецФункции

Функция ВыйтиИзИгровойКомнаты(Знач ИдентификаторУчастника,Знач ИгроваяКомната) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СКЧата.ИдентификаторКомнаты КАК ИдентификаторКомнаты,
	|	СКЧата.ИдентификаторУчастника КАК ИдентификаторУчастника
	|ИЗ
	|	РегистрСведений.СоставКомнатыДляЧата КАК СКЧата
	|ГДЕ
	|	СКЧата.ИдентификаторУчастника = &ИдентификаторУчастника
	|	И СКЧата.ИдентификаторКомнаты = &ИдентификаторКомнаты";
	Запрос.УстановитьПараметр("ИдентификаторУчастника",ИдентификаторУчастника);
	Запрос.УстановитьПараметр("ИдентификаторКомнаты",ИгроваяКомната);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.СоставКомнатыДляЧата.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ИдентификаторКомнаты = Выборка.ИдентификаторКомнаты;
		МенеджерЗаписи.ИдентификаторУчастника = Выборка.ИдентификаторУчастника;
		МенеджерЗаписи.Удалить();
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

